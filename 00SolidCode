// MOD-004-S24: SUGERENCIAS PRODUCTOS V2 [INICIO]
function cargarSugerenciasCategoria(idFila) {
  const selectCategoria = document.getElementById(`categoria${idFila}`);
  const inputProducto = document.getElementById(`producto${idFila}`);
  const datalistId = `sugerencias${idFila}`;
  let datalist = document.getElementById(datalistId);
  
  // Crear datalist si no existe
  if (!datalist) {
    datalist = document.createElement('datalist');
    datalist.id = datalistId;
    document.body.appendChild(datalist); // ✅ CORREGIDO: dalist → datalist
  }
  
  const categoria = selectCategoria.value.trim();
  
  // Sin categoría = limpia sugerencias
  if (!categoria || categoria === "Sin categoría") {
    datalist.innerHTML = '';
    inputProducto.removeAttribute('list');
    return;
  }
  
  // Conectar input al datalist
  inputProducto.setAttribute('list', datalistId);
  
  // Llamar Master.gs MOD-007 (5000 registros)
  google.script.run
    .withSuccessHandler(function(sugerencias) {
      datalist.innerHTML = '';
      if (sugerencias && sugerencias.length > 0) {
        sugerencias.forEach(producto => {
          const option = document.createElement('option');
          option.value = producto;
          datalist.appendChild(option);
        });
        console.log(`Sugerencias cargadas para fila ${idFila}: ${sugerencias.length} productos`);
      }
    })
    .withFailureHandler(function(error) {
      console.error(`Error sugerencias fila ${idFila}:`, error);
      datalist.innerHTML = '';
    })
    .getProductosPorCategoriaTop20(categoria, 5000);
}
